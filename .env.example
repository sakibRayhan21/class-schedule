# Supabase Cloud Database Configuration
# Replace these with your actual credentials from Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Admin access. Change these before deploying.
ADMIN_PASSWORD=change-me-now
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Required for persistent password changes and server-side writes on Supabase.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
